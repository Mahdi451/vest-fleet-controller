{
  "name": "vest-fleet-controller",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Private local event-driven Vest copier prototype with offline risk controls and durable execution records.",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "preview": "node --import tsx apps/controller/src/cli.ts preview",
    "simulate": "node --import tsx apps/controller/src/cli.ts simulate",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm security:check && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "dashboard": "node --import tsx apps/dashboard/server.ts",
    "setup:private": "node --import tsx apps/dashboard/setup-private.ts",
    "host:doctor": "node --import tsx apps/dashboard/host.ts doctor",
    "host:protect": "node --import tsx apps/dashboard/host.ts protect",
    "observe:vest": "node --import tsx apps/vest-observer/cli.ts",
    "security:check": "node --import tsx scripts/security-check.ts",
    "build:local": "node --import tsx scripts/build-local-trading.ts",
    "verify:functional": "node --import tsx scripts/verify-functional.ts"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "koffi": "3.3.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "eslint": "^10.11.0",
    "playwright": "1.62.1",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11"
  }
}
